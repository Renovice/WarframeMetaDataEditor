<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>openwf-metadata-updater</AssemblyName>
    <RootNamespace>OpenWFMetadataUpdater</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\editor\Core\Core.csproj" />
    <None Include="..\editor\lib\oo2core_9.dll" Link="oo2core_9.dll"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\editor\lib\oo2core_9.dll')" />
  </ItemGroup>
</Project>
