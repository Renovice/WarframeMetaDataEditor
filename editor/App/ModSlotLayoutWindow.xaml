<Window x:Class="MetadataPatchEditor.ModSlotLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Native Mod Slot Layout" Height="360" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0F1822">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE8F2"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}"/>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
        <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"/>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Native mod-slot layout" FontSize="17" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" x:Name="TargetText" Margin="0,5,0,14" Foreground="#B6C8D4" TextWrapping="Wrap"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Additional ordinary mod slots" VerticalAlignment="Center"/>
            <TextBox x:Name="AdditionalBox" Grid.Column="1" Text="0"/>
            <TextBlock Grid.Column="2" Text="0–16" Foreground="#91A6B7" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Aura / Stance slots" VerticalAlignment="Center"/>
            <ComboBox x:Name="AuraCombo" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/></ComboBox>
            <TextBlock Grid.Column="2" Text="category-gated" Foreground="#91A6B7" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="New-slot polarity" VerticalAlignment="Center"/>
            <ComboBox x:Name="PolarityCombo" Grid.Column="1"/>
        </Grid>
        <Border Grid.Row="5" Margin="0,15,0,12" Padding="10" Background="#10202C" BorderBrush="#29475A" BorderThickness="1">
            <TextBlock x:Name="RuleText" Foreground="#d8bf79" TextWrapping="Wrap"/>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryDialogButton}" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Generate Layout" IsDefault="True" Click="Generate_Click"/>
        </StackPanel>
    </Grid>
</Window>
