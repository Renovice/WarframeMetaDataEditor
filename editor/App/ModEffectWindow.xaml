<Window x:Class="MetadataPatchEditor.ModEffectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Native Mod Effect" Width="760" Height="680" MinWidth="680" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#0F1822">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE8F2"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"/>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#14212D" BorderBrush="#2D4254" BorderThickness="1" Padding="14" CornerRadius="5">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Margin="0,7,0,0" Foreground="#B6C8D4" TextWrapping="Wrap"
                           Text="Adds another ordinary entry to this mod's native Upgrades list. The Fire-resistance preset is copied from the current vanilla Flame Repellent shape; Custom exposes the decoded enum families."/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto">
            <Border Background="#14212D" BorderBrush="#2D4254" BorderThickness="1" Padding="14" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Template"/><ComboBox x:Name="PresetBox" Grid.Row="0" Grid.Column="1" Margin="0,3" SelectionChanged="PresetBox_SelectionChanged"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Stat / effect type" ToolTip="The decoded UpgradeType enum controlling what gameplay stat changes."/><ComboBox x:Name="UpgradeTypeBox" Grid.Row="1" Grid.Column="1" Margin="0,3" IsEditable="False"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Operation" ToolTip="How the value combines with the existing stat."/><ComboBox x:Name="OperationBox" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Value per rank"/><TextBox x:Name="ValueBox" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Damage type / element"/><ComboBox x:Name="DamageTypeBox" Grid.Row="4" Grid.Column="1" Margin="0,3"/>
                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Visible card description"/>
                    <CheckBox x:Name="IncludeDescriptionBox" Grid.Row="5" Grid.Column="1" Margin="0,8"
                              Content="Add this effect as a visible line on the mod card" Foreground="#DCE8F2"
                              Checked="IncludeDescriptionBox_Changed" Unchecked="IncludeDescriptionBox_Changed"/>
                    <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Description localization" ToolTip="Existing /Lotus/Language/... key used to render this effect on the card."/><TextBox x:Name="LocTagBox" Grid.Row="6" Grid.Column="1" Margin="0,3"/>
                    <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Display rules"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                        <CheckBox x:Name="PercentBox" Content="Display as percent" Foreground="#DCE8F2" Margin="0,0,18,0"/>
                        <CheckBox x:Name="SmallerBox" Content="Smaller is better" Foreground="#DCE8F2"/>
                    </StackPanel>
                    <Border Grid.Row="8" Grid.ColumnSpan="2" Background="#10202C" BorderBrush="#A6752A" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                        <TextBlock x:Name="EvidenceText" Foreground="#E2C174" TextWrapping="Wrap"
                                   Text="The Fire Resistance preset reuses the game's existing translated Flame Repellent description line. Custom free-form card text is not invented here; custom effects require a real existing localization key."/>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>
        <DockPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" Foreground="#F0B16B" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Add Effect" Click="Add_Click" MinWidth="120"/>
                <Button Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0" Style="{StaticResource SecondaryDialogButton}" MinWidth="90"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
