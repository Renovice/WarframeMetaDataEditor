<UserControl x:Class="MetadataPatchEditor.MetadataValueEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" MinHeight="30">
    <UserControl.Resources>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#101B25"/><Setter Property="Foreground" Value="#8DA2B2"/>
            <Setter Property="BorderBrush" Value="#42596A"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1D3B50"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#735F2A"/><Setter Property="Foreground" Value="#F5D87C"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#A68A40"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TextBox x:Name="TextEditor" Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center" ToolTip="{Binding FieldDescription, ElementName=Root}"/>
        <ComboBox x:Name="EnumEditor" ItemsSource="{Binding DescribedOptions, ElementName=Root}"
                  SelectedValuePath="Value" SelectedValue="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="{Binding SelectedItem.Tooltip, RelativeSource={RelativeSource Self}}"
                  ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000"
                  ItemTemplate="{StaticResource MetadataOptionTemplate}"
                  IsEditable="False" VerticalContentAlignment="Center"/>
        <Grid x:Name="NumberEditor" MouseEnter="NumberEditor_MouseEnter" MouseLeave="NumberEditor_MouseLeave">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="NumberBox" Grid.Column="0" Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="NumberBox_PreviewKeyDown" GotKeyboardFocus="NumberBox_GotKeyboardFocus"
                     LostKeyboardFocus="NumberBox_LostKeyboardFocus" VerticalContentAlignment="Center"
                     ToolTip="{Binding FieldDescription, ElementName=Root}"/>
            <Grid x:Name="SpinnerButtons" Grid.Column="1" Width="25" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Button Grid.Row="0" Content="▲" Padding="0" Margin="1,0,0,1" FontSize="8" Click="Increment_Click"
                        ToolTip="Increase by the field's natural step"/>
                <Button Grid.Row="1" Content="▼" Padding="0" Margin="1,0,0,0" FontSize="8" Click="Decrement_Click"
                        ToolTip="Decrease by the field's natural step"/>
            </Grid>
        </Grid>
        <Border x:Name="BooleanEditor" Background="#101B25" BorderBrush="#2D4254" BorderThickness="1" Padding="3">
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                <ToggleButton x:Name="OffButton" Grid.Column="0" Content="✕" Click="Off_Click" Padding="6,2">
                    <ToggleButton.ToolTip><StackPanel MaxWidth="420">
                        <TextBlock Text="Disabled (0)" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FieldDescription, ElementName=Root}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel></ToggleButton.ToolTip>
                </ToggleButton>
                <ToggleButton x:Name="OnButton" Grid.Column="1" Content="✓" Click="On_Click" Padding="6,2">
                    <ToggleButton.ToolTip><StackPanel MaxWidth="420">
                        <TextBlock Text="Enabled (1)" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FieldDescription, ElementName=Root}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel></ToggleButton.ToolTip>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</UserControl>
