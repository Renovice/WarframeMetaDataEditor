<Window x:Class="MetadataPatchEditor.WarframeStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Warframe Editor" Width="1220" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#0F1822">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#14212D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D4254"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE8F2"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource VisualSectionBorder}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="18,0,0,0">
                    <TextBlock Text="Preview" Foreground="#8FB6CA" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="HeaderPreview" FontSize="18" FontWeight="SemiBold" Foreground="#72D69A" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,5,0,0" Foreground="#B6C8D4" TextWrapping="Wrap"
                               Text="Edit native powersuit stats with readable controls. Raw fields remain preserved and available in the main Advanced table."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" Background="#111E29" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Rank preview = base plus the native rank milestone totals. It is not a modded Arsenal total." Foreground="#8196A5" TextWrapping="Wrap" Margin="2,10,2,2"/>
                <StackPanel>
                    <TextBlock Text="WARFRAME SECTIONS" Foreground="#7EC9EC" FontWeight="SemiBold" Margin="4,2,0,12"/>
                    <Button Style="{StaticResource VisualNavButton}" Content="◈  Overview" Click="Overview_Click"/>
                    <Button Style="{StaticResource VisualNavButton}" Content="♥  Core stats" Click="Stats_Click"/>
                    <Button Style="{StaticResource VisualNavButton}" Content="↑  Rank scaling" Click="Ranks_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
            <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Warframe overview" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,5,0,14" Foreground="#AFC1CC" TextWrapping="Wrap"
                               Text="These are native unmodded values. Rank 30 includes the decoded LevelUpgrades milestones."/>
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource VisualStatCard}" MouseLeftButtonUp="StatsCard_Click">
                            <StackPanel><TextBlock Text="♥ HEALTH" Foreground="#F08A8A" FontWeight="SemiBold"/><TextBlock x:Name="HealthPreview" FontSize="22" Margin="0,6,0,0"/><TextBlock Text="rank 0 → rank 30" Foreground="#91A5B2"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource VisualStatCard}" MouseLeftButtonUp="StatsCard_Click">
                            <StackPanel><TextBlock Text="◆ SHIELDS" Foreground="#7EC9EC" FontWeight="SemiBold"/><TextBlock x:Name="ShieldPreview" FontSize="22" Margin="0,6,0,0"/><TextBlock Text="rank 0 → rank 30" Foreground="#91A5B2"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource VisualStatCard}" MouseLeftButtonUp="StatsCard_Click">
                            <StackPanel><TextBlock Text="⬡ ARMOR" Foreground="#F2C777" FontWeight="SemiBold"/><TextBlock x:Name="ArmorPreview" FontSize="22" Margin="0,6,0,0"/><TextBlock Text="native armor" Foreground="#91A5B2"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource VisualStatCard}" MouseLeftButtonUp="StatsCard_Click">
                            <StackPanel><TextBlock Text="✦ ENERGY" Foreground="#D5A7F0" FontWeight="SemiBold"/><TextBlock x:Name="EnergyPreview" FontSize="22" Margin="0,6,0,0"/><TextBlock Text="rank 0 → rank 30" Foreground="#91A5B2"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource VisualSectionBorder}">
                        <StackPanel>
                            <TextBlock Text="Resources &amp; movement" FontSize="16" FontWeight="SemiBold"/>
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <StackPanel><TextBlock Text="Starting Energy" Foreground="#91A5B2"/><TextBlock x:Name="StartingEnergyPreview" FontSize="20"/></StackPanel>
                                <StackPanel><TextBlock Text="Sprint Speed" Foreground="#91A5B2"/><TextBlock x:Name="SprintPreview" FontSize="20"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VisualInfoBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="What the preview means" Foreground="#57B9E8" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#C7D4DC"
                                       Text="The left number is the base metadata value. The right number adds every existing LevelUpgrades milestone through rank 30. Mods, Archon Shards, abilities, and mission buffs are not included."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="StatsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Core stats" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,12" Foreground="#AFC1CC" TextWrapping="Wrap"
                               Text="Edit base values directly. Each control writes the exact native field already owned by this Warframe."/>
                    <ItemsControl x:Name="BaseStatsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource VisualSectionBorder}" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Group}" Foreground="#7EC9EC" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#AFC1CC" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,18,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="16" VerticalContentAlignment="Center" TextChanged="AnyValue_TextChanged"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RanksPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Rank scaling" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,12" Foreground="#AFC1CC" TextWrapping="Wrap"
                               Text="Edit the total bonus earned through rank 30. The editor scales the existing milestone amounts proportionally and keeps their original rank positions."/>
                    <ItemsControl x:Name="RankStatsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource VisualSectionBorder}" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StockTotal, StringFormat=Stock total: {0:0.#########}}" Foreground="#76D4A2" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#AFC1CC" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,18,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="16" VerticalContentAlignment="Center" TextChanged="AnyValue_TextChanged"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource VisualInfoBorder}" Margin="0,3,0,0">
                        <TextBlock TextWrapping="Wrap" Text="This does not create a new formula or a repeating script. It changes the values in the Warframe's existing native LevelUpgrades array once in the metadata patch."/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,13,0,0">
            <TextBlock x:Name="StatusText" Foreground="#F0B16B" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Apply to Patch" Click="Apply_Click" MinWidth="140"/>
                <Button Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0" Style="{StaticResource SecondaryDialogButton}" MinWidth="90"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
