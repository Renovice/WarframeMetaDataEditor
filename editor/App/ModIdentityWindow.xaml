<Window x:Class="MetadataPatchEditor.ModIdentityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod Client and Server Metadata" Height="760" Width="780"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0F1822">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE8F2"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}"/>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE8F2"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"/>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="#14212D"/><Setter Property="BorderBrush" Value="#2D4254"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TargetText" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="CLIENT METADATA" Foreground="#8fd2ff" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Visible rarity" VerticalAlignment="Center"/>
                <ComboBox x:Name="ClientRarityCombo" Grid.Row="1" Grid.Column="1" Width="250" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Client FusionLimit" VerticalAlignment="Center"/>
                <ComboBox x:Name="ClientFusionCombo" Grid.Row="2" Grid.Column="1" Width="250" HorizontalAlignment="Left"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SectionBorder}">
            <StackPanel>
                <TextBlock Text="OPENWF SERVER DEFINITION" Foreground="#e8b36b" FontWeight="Bold" Margin="0,0,0,10"/>
                <CheckBox x:Name="ServerOverrideCheck" Content="Create or update an enabled OpenWF definition package"
                          Margin="0,0,0,10" Checked="ServerOverride_Changed" Unchecked="ServerOverride_Changed"/>
                <Grid x:Name="ServerDefinitionPanel">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Server rarity" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ServerRarityCombo" Grid.Row="0" Grid.Column="1" Width="250" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Server numeric fusion limit (0–10)" VerticalAlignment="Center"/>
                    <TextBox x:Name="ServerRankBox" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left"/>
                </Grid>
                <TextBlock x:Name="ServerModeText" Margin="0,10,0,0" Foreground="#B6C8D4" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SectionBorder}">
            <StackPanel>
                <TextBlock Text="SERVER LOCATION AND LIFECYCLE" Foreground="#d7c77a" FontWeight="Bold" Margin="0,0,0,10"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Style="{StaticResource SecondaryDialogButton}" Click="Browse_Click"/>
                    <TextBox x:Name="ServerPathBox"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DisableServerPatchButton" Content="Disable installed server package" Style="{StaticResource WarningDialogButton}"
                            Click="DisableServerPatch_Click"/>
                    <TextBlock x:Name="InstalledStateText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#B6C8D4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="#10202C" BorderBrush="#29475A" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Text="INVENTORY" Foreground="#8fd2ff" FontWeight="Bold" Margin="0,0,0,8"/>
                <CheckBox IsChecked="True" IsEnabled="False" Content="Do not modify owned mods or save data"/>
                <TextBlock Margin="0,8,0,0" Foreground="#C5D5DF" TextWrapping="Wrap"
                           Text="Client-only is the default. OpenWF can preserve an owned {&quot;lvl&quot;:10} Stretch without publishing a Legendary/rank-10 server definition. Enabling the server component changes OpenWF's effective definition, WebUI, Public Export, and definition-based tools only; it never edits inventory."/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#ff8b8b" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="430"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryDialogButton}" Margin="8,0,0,0" Click="Cancel_Click"/>
                <Button Content="Prepare patch" Style="{StaticResource WarningDialogButton}" Margin="8,0,0,0" Click="Accept_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
