<Window x:Class="MetadataPatchEditor.ServerMetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generic OpenWF Server Metadata" Height="760" Width="1040"
        WindowStartupLocation="CenterOwner" Background="#0F1822">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCE8F2"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}"/>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
        <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TargetText" Grid.Row="0" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="#14212D" BorderBrush="#2D4254" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="SpaceNinjaServer" VerticalAlignment="Center"/>
                <TextBox x:Name="ServerPathBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Style="{StaticResource SecondaryDialogButton}" Margin="0,0,0,8" Click="Browse_Click"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Matching server entry" VerticalAlignment="Center"/>
                <ComboBox x:Name="MatchCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="Match_Changed"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Edit JSON values from the selected Public Export entry. Strings require quotes; objects and arrays use normal JSON." Foreground="#B6C8D4" Margin="0,0,0,6"/>

        <DataGrid x:Name="FieldGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="#101B25" Foreground="#DCE8F2" RowBackground="#101B25" AlternatingRowBackground="#15232F"
                  BorderBrush="#2D4254" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Server field" Binding="{Binding Field}" IsReadOnly="True" Width="220"/>
                <DataGridTextColumn Header="JSON type" Binding="{Binding JsonType}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="Original JSON" Binding="{Binding OriginalJson}" IsReadOnly="True" Width="280"/>
                <DataGridTextColumn Header="New JSON" Binding="{Binding ValueJson, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChanged}" Value="True"><Setter Property="Background" Value="#5a441c"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,8">
            <TextBlock Text="Add server field:" VerticalAlignment="Center"/>
            <TextBox x:Name="NewFieldNameBox" Width="210" Margin="8,0,0,0"/>
            <TextBlock Text="JSON value:" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox x:Name="NewFieldValueBox" Width="250" Text="0" Margin="8,0,0,0"/>
            <Button Content="Add field" Background="#237A47" BorderBrush="#3B9B61" Margin="8,0,0,0" Click="AddField_Click"/>
        </StackPanel>

        <Border Grid.Row="5" Background="#10202C" BorderBrush="#29475A" BorderThickness="1" Padding="10">
            <TextBlock TextWrapping="Wrap" Foreground="#C5D5DF"
                       Text="This changes OpenWF's in-memory server/Public Export entry only. It does not rewrite the installed package dependency, client metadata, account inventory, or save data. New fields are allowed, but a field the server never consumes will have no effect."/>
        </Border>

        <DockPanel Grid.Row="6" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="DisablePackageButton" Content="Disable installed package" Style="{StaticResource WarningDialogButton}" Click="DisablePackage_Click"/>
                <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#C5D5DF" TextWrapping="Wrap" MaxWidth="470"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryDialogButton}" Margin="8,0,0,0" Click="Cancel_Click"/>
                <Button Content="Prepare server package" Style="{StaticResource WarningDialogButton}" Margin="8,0,0,0" Click="Accept_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
