<Window x:Class="MetadataPatchEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MetadataPatchEditor"
        Title="OpenWF Metadata Patch Editor" Height="900" Width="1540"
        MinHeight="720" MinWidth="1180" Background="#0f1822">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#14212d"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2d4254"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2684c7"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#dce8f2"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101b25"/><Setter Property="Foreground" Value="#e8f0f6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#459bd2"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="TealButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#247C7D"/><Setter Property="BorderBrush" Value="#3A999A"/>
        </Style>
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#237A47"/><Setter Property="BorderBrush" Value="#3B9B61"/>
        </Style>
        <Style x:Key="PurpleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#665093"/><Setter Property="BorderBrush" Value="#826BB0"/>
        </Style>
        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#A65D24"/><Setter Property="BorderBrush" Value="#C57A3E"/>
        </Style>
        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#8A6A25"/><Setter Property="BorderBrush" Value="#AA873C"/>
        </Style>
        <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#394C5A"/><Setter Property="BorderBrush" Value="#526A7A"/>
        </Style>
        <Style x:Key="CategoryToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#101B25"/><Setter Property="Foreground" Value="#DCE8F2"/>
            <Setter Property="BorderBrush" Value="#2D4254"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <Grid><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            <TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#9CCCE9"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#193449"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#244A63"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#4AA4D8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#DCE8F2"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#193449"/><Setter Property="Foreground" Value="White"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#245F86"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#d5e0e8"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="6,4"/><Setter Property="Foreground" Value="#dce8f2"/></Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4fb3f6"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="OpenWF Metadata Patch Editor" FontWeight="SemiBold" FontSize="16" Margin="2,0,0,8"/>
            <WrapPanel Margin="0,0,0,5">
                <Button x:Name="DecodeBtn" Content="Decode from Cache…" Click="DecodeBtn_Click"/>
                <TextBlock Text="Category" VerticalAlignment="Center" Margin="8,0,6,7"/>
                <Grid Width="390" Height="34" VerticalAlignment="Top" Margin="0,0,10,7">
                    <ToggleButton x:Name="CategoryToggle" Content="☷  Category" Style="{StaticResource CategoryToggleStyle}"
                                  ToolTip="Choose a grouped metadata category."/>
                    <Popup x:Name="CategoryPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=CategoryToggle}"
                           IsOpen="{Binding IsChecked, ElementName=CategoryToggle, Mode=TwoWay}" StaysOpen="True"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="390" MaxHeight="610" Background="#0D1720" BorderBrush="#3A596E" BorderThickness="1" Padding="5">
                            <Border.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#245F86"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#193449"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                            </Border.Resources>
                            <TreeView x:Name="CategoryTree" Background="#0D1720" BorderThickness="0" Foreground="#DCE8F2"
                                      ItemContainerStyle="{StaticResource DarkTreeItem}" SelectedItemChanged="CategoryTree_SelectedItemChanged"/>
                        </Border>
                    </Popup>
                </Grid>
                <CheckBox x:Name="GameplayCheck" Content="Gameplay only" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,7" Click="GameplayCheck_Changed"/>
                <CheckBox x:Name="BatchCheck" Content="Batch apply to filtered list" VerticalAlignment="Center" Margin="0,0,14,7"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,5">
                <Button x:Name="DumpBtn" Content="Dump All…" Style="{StaticResource TealButton}" Click="DumpBtn_Click"/>
                <Button x:Name="MergeBtn" Content="Merge Patches…" Style="{StaticResource TealButton}" Click="MergeBtn_Click" ToolTip="Combine patch files into one and remove duplicates."/>
                <Button x:Name="GameplayMetadataBtn" Content="Open Visual Editor…" Style="{StaticResource OrangeButton}" IsEnabled="False" Click="GameplayMetadataBtn_Click" ToolTip="Open the visual status, weapon, or Warframe editor. You can also double-click a supported item."/>
                <Button x:Name="ModEffectBtn" Content="Add Mod Effect…" Style="{StaticResource OrangeButton}" IsEnabled="False" Click="ModEffectBtn_Click" ToolTip="Append a reusable native Upgrades entry using decoded enum choices."/>
                <Button x:Name="ModLayoutBtn" Content="Mod Slot Layout…" Style="{StaticResource GoldButton}" Click="ModLayoutBtn_Click" ToolTip="Add native-grid ordinary and supported Aura or Stance slots."/>
                <Button x:Name="ModIdentityBtn" Content="Mod Client &amp; Server…" Style="{StaticResource PurpleButton}" Click="ModIdentityBtn_Click" ToolTip="Create coordinated removable client and server-definition patches."/>
                <Button x:Name="ServerMetadataBtn" Content="Server Metadata…" Style="{StaticResource PurpleButton}" Click="ServerMetadataBtn_Click" ToolTip="Create a removable OpenWF Public Export overlay."/>
            </WrapPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ListLabel" Text="Decode the cache to begin" Style="{StaticResource PanelHeader}"/>
                    <Border DockPanel.Dock="Top" Background="#10202C" BorderBrush="#29475A" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,7">
                        <TextBlock x:Name="CategoryHelp" Foreground="#B8CAD5" FontSize="11" TextWrapping="Wrap"
                                   Text="Choose a category to see what its scope means."/>
                    </Border>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Margin="0,0,0,6" TextChanged="SearchBox_TextChanged" ToolTip="Search the selected metadata category."/>
                    <TextBlock DockPanel.Dock="Top" x:Name="CountText" Foreground="#91a6b7" Margin="2,0,0,7"/>
                    <ListBox x:Name="ItemList" Background="#101b25" Foreground="#dce8f2" BorderBrush="{StaticResource BorderBrush}"
                             SelectionChanged="ItemList_SelectionChanged" MouseDoubleClick="ItemList_MouseDoubleClick"
                             ToolTip="Select an item to inspect it. Double-click a weapon or status effect to open its visual editor."/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="175"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PathText" Grid.Row="0" Text="Decode from cache, pick a category, then an item." FontWeight="SemiBold" FontSize="13" Margin="2,0,2,8" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="1" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="GroupCombo" Grid.Column="0" Height="32" SelectionChanged="GroupCombo_SelectionChanged"/>
                        <TextBox x:Name="FieldFilter" Grid.Column="2" Height="32" TextChanged="FieldFilter_TextChanged" ToolTip="Search fields, descriptions, and exact paths."/>
                        <CheckBox x:Name="AdvancedFieldsCheck" Grid.Column="4" Content="Advanced paths" VerticalAlignment="Center"
                                  Checked="AdvancedFieldsCheck_Changed" Unchecked="AdvancedFieldsCheck_Changed"
                                  ToolTip="Show internal patch operation and exact metadata path columns."/>
                    </Grid>
                    <DataGrid x:Name="FieldGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#101b25" Foreground="#dce8f2" RowBackground="#101b25"
                              AlternatingRowBackground="#15232f" BorderBrush="{StaticResource BorderBrush}" SelectionMode="Single" SelectionChanged="FieldGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#245F86"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#193449"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#DCE8F2"/>
                        </DataGrid.Resources>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="True" Margin="0,0,0,7" Background="#111E29" BorderBrush="#2D4254" BorderThickness="1">
                                                        <Expander.Header>
                                                            <DockPanel Margin="7,5">
                                                                <Border Width="4" Background="#2684C7" CornerRadius="2" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding Name}" Foreground="#66BDF3" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat=  ·  {0} fields}" Foreground="#8299A9" Margin="7,0,0,0"/>
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Setting" Binding="{Binding Label}" IsReadOnly="True" Width="235"/>
                            <DataGridTemplateColumn Header="Value" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:MetadataValueEditor Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}"
                                                                   EditorKind="{Binding EditorKind}" Options="{Binding Options}"
                                                                   FieldKey="{Binding Key}" FieldDescription="{Binding Description}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="What it controls" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="5,3" Foreground="#C5D5DF"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="OperationColumn" Header="Op" Binding="{Binding Op}" IsReadOnly="True" Width="60" Visibility="Collapsed"/>
                            <DataGridTextColumn x:Name="ExactPathColumn" Header="Exact metadata path" Binding="{Binding Path}" IsReadOnly="True" Width="330" Visibility="Collapsed"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip MaxWidth="520">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#EAF4FA"/>
                                                <TextBlock Text="{Binding Description}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#C5D5DF"/>
                                                <TextBlock Text="{Binding Path}" Margin="0,5,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" Foreground="#78BDE8"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers><DataTrigger Binding="{Binding IsChanged}" Value="True"><Setter Property="Background" Value="#344a30"/></DataTrigger></Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="Patch preview" Style="{StaticResource PanelHeader}" Margin="2,9,0,5"/>
                    <TextBox x:Name="Preview" Grid.Row="4" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True" Background="#0b141c" Foreground="#cfe0ed" SelectionBrush="#245F86" SelectionOpacity="0.7"/>
                    <StackPanel Grid.Row="5">
                        <TextBlock x:Name="RivenReadout" Margin="2,7,0,0" Foreground="#d7bd73" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Status" Margin="2,6,0,0" Foreground="#8fd09b" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="360"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Field details" Style="{StaticResource PanelHeader}"/>
                        <TextBlock x:Name="DetailTitle" Text="Select a field" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailDescription" Margin="0,8,0,0" Foreground="#b9c9d5" Text="Choose a row to see what it controls and the exact patch target." TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailPath" Margin="0,8,0,0" Foreground="#78bde8" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Actions" Style="{StaticResource PanelHeader}"/>
                        <TextBlock Text="Patch file" Foreground="#aebfcb" Margin="0,0,0,4"/>
                        <TextBox x:Name="PatchName" Margin="0,0,0,9"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviewBtn" Grid.Column="0" Content="Refresh" HorizontalContentAlignment="Center" Margin="0" Click="PreviewBtn_Click"/>
                            <Button x:Name="SaveBtn" Grid.Column="2" Content="Save Patch…" Style="{StaticResource GreenButton}" HorizontalContentAlignment="Center" Margin="0" Click="SaveBtn_Click"/>
                            <Button x:Name="ResetBtn" Grid.Column="4" Content="Reset" Style="{StaticResource NeutralButton}" HorizontalContentAlignment="Center" Margin="0" Click="ResetBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Patch controls" Style="{StaticResource PanelHeader}"/>
                        <TextBlock Text="Scale changed numerical values" Foreground="#aebfcb" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="MultBox" Grid.Column="0" Text="2" VerticalContentAlignment="Center"/>
                            <Button x:Name="MultBtn" Grid.Column="2" Content="Apply" Style="{StaticResource GoldButton}" Margin="0" HorizontalContentAlignment="Center" Click="MultBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
