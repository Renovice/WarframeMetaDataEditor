<Window x:Class="MetadataPatchEditor.StatusDotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MetadataPatchEditor"
        Title="Status DOT Builder" Height="690" Width="820" MinHeight="640" MinWidth="720"
        WindowStartupLocation="CenterOwner" Background="#111922">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#18232E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#30404F"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6EDF3"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"/>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E6EDF3"/></Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource VisualSectionBorder}" Padding="15">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="SupportLabel" Margin="0,7,0,0" Foreground="#8FCBE8" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource VisualInfoBorder}">
            <StackPanel>
                <TextBlock Text="What this adds" Foreground="#57B9E8" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="The original status reaction stays intact. This adds a native damage-over-time payload that ticks using a fraction of the triggering hit. It does not change the weapon's status chance."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource VisualSectionBorder}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="DOT damage type" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <local:MetadataValueEditor x:Name="DamageTypeEditor" MinWidth="280" EditorKind="Enum"
                                               FieldKey="Type" FieldDescription="The element dealt by each DOT tick."/>
                    <TextBlock Margin="0,5,0,0" Foreground="#9EB1BD" TextWrapping="Wrap"
                               Text="The element dealt by each DOT tick. This can match the status (Cold → Cold DOT) or use another decoded damage type."/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,18,0,0" Text="Damage per tick" FontWeight="SemiBold" VerticalAlignment="Top"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                    <TextBox x:Name="PercentBox"/>
                    <TextBlock Margin="0,5,0,0" Foreground="#9EB1BD" TextWrapping="Wrap"
                               Text="Fraction of the triggering hit used as the DOT basis. 0.5 = 50%; 1 = 100%."/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,18,0,0" Text="Repeated-hit handling" FontWeight="SemiBold" VerticalAlignment="Top"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,14,0,0">
                    <local:MetadataValueEditor x:Name="ConsolidationEditor" EditorKind="Enum"
                                               FieldKey="ConsolidateDamageOverTime"
                                               FieldDescription="Controls the native repeated-DOT/consolidation mode."/>
                    <TextBlock Margin="0,5,0,0" Foreground="#9EB1BD" TextWrapping="Wrap"
                               Text="Choose the native repeated-DOT mode yourself. Original / inherited writes no override; the exact numeric identifiers 0, 1, and 10 are preserved."/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,18,0,0" Text="Proc storage / ownership" FontWeight="SemiBold" VerticalAlignment="Top"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,14,0,0">
                    <local:MetadataValueEditor x:Name="StackStyleEditor" EditorKind="Enum"
                                               FieldKey="StackStyle"
                                               FieldDescription="Controls status-record storage and source ownership."/>
                    <TextBlock Margin="0,5,0,0" Foreground="#9EB1BD" TextWrapping="Wrap"
                               Text="Choose one shared proc record, one record per weapon/ability source, or one independent record per hit. Original / inherited writes no override."/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,18,0,0" Text="Highest DOT basis" FontWeight="SemiBold" VerticalAlignment="Top"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,14,0,0">
                    <local:MetadataValueEditor x:Name="HighestBasisEditor" EditorKind="Enum"
                                               FieldKey="UseHighestDamageOverTime"
                                               FieldDescription="Controls whether a compatible shared/consolidated DOT keeps its strongest basis."/>
                    <TextBlock Margin="0,5,0,0" Foreground="#9EB1BD" TextWrapping="Wrap"
                               Text="Original / inherited writes no override. Off writes 0; On writes 1 and keeps the highest basis only when this handler's native path matches or consolidates DOT damage."/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorLabel" Foreground="#F2C777" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Apply DOT" Click="Apply_Click" MinWidth="130"/>
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryDialogButton}" Margin="8,0,0,0" MinWidth="100"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
